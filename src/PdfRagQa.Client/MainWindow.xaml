<Window x:Class="PdfRagQa.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PdfRagQa 智能问答客户端"
        Height="720" Width="980"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- API 地址 + 状态栏 -->
        <DockPanel Grid.Row="0" Margin="8,8,8,0">
            <TextBlock Text="API 地址：" VerticalAlignment="Center" />
            <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Width="320" VerticalAlignment="Center" />
            <Button Content="新会话" Command="{Binding NewSessionCommand}" DockPanel.Dock="Right" />
        </DockPanel>

        <!-- 文档导入区 -->
        <GroupBox Grid.Row="1" Header="1. 导入文档（路径方式）">
            <StackPanel>
                <DockPanel>
                    <Button Content="选择 PDF…" Command="{Binding BrowseFileCommand}" Width="90" />
                    <TextBox Text="{Binding FilePath}" Margin="4,0" VerticalAlignment="Center" IsReadOnly="True" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <ComboBox ItemsSource="{Binding AvailableDocTypes}"
                              SelectedItem="{Binding SelectedDocType}"
                              DisplayMemberPath="Label"
                              Width="220" VerticalAlignment="Center" />
                    <Button Content="导入" Command="{Binding ImportCommand}" VerticalAlignment="Center" DockPanel.Dock="Right" />
                </DockPanel>
                <TextBlock Text="{Binding ImportStatus}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#2e7d32" />
                <ProgressBar Height="18"
                             Margin="0,6,0,0"
                             Minimum="0"
                             Maximum="{Binding ImportProgressMaximum}"
                             Value="{Binding ImportProgressValue}"
                             IsIndeterminate="{Binding IsImportIndeterminate}" />
                <TextBlock Text="{Binding ImportProgressText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#666" />
            </StackPanel>
        </GroupBox>

        <!-- 问答与结果区 -->
        <GroupBox Grid.Row="2" Header="2. 提问（依据已导入文档回答，带引用溯源）">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button Content="提问" Command="{Binding AskCommand}" CommandParameter="" DockPanel.Dock="Right" />
                    <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Grid.Row="1" Text="{Binding AnswerMeta}" Margin="0,6,0,6" TextWrapping="Wrap" Foreground="#555" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 答案 -->
                    <GroupBox Grid.Column="0" Header="答案" Padding="4">
                        <TextBox Text="{Binding Answer, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontSize="14"
                                 Background="#fafafa" />
                    </GroupBox>

                    <!-- 引用溯源 -->
                    <GroupBox Grid.Column="2" Header="引用溯源" Padding="4">
                        <ListBox ItemsSource="{Binding Citations}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock>
                                            <Run Text="{Binding DocumentTitle}" FontWeight="Bold" />
                                            <Run Text="  /  " />
                                            <Run Text="第" /><Run Text="{Binding PageNo}" /><Run Text="页" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Section}" Foreground="#666" FontStyle="Italic" />
                                        <TextBlock Text="{Binding TextPreview}" TextWrapping="Wrap" Foreground="#333" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 错误信息 -->
        <StatusBar Grid.Row="3">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#c62828" TextWrapping="Wrap" />
            <Separator />
            <TextBlock Text="{Binding IsBusy, StringFormat='忙...'}" />
        </StatusBar>
    </Grid>
</Window>